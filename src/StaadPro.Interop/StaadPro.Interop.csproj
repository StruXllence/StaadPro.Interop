<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1589;CS1590</WarningsAsErrors>
    <AssemblyName>StaadPro.Interop</AssemblyName>
    <RootNamespace>StaadPro.Interop</RootNamespace>
    <PackageId>StaadPro.Interop</PackageId>
    <Version>1.0.0</Version>
    <ReleaseDocumentationVersion>1.0.0-preview.20261104</ReleaseDocumentationVersion>
    <PackageVersion>$(ReleaseDocumentationVersion)</PackageVersion>
    <Authors>Srinivasa Rao Masanam</Authors>
    <Company>StruXllence</Company>
    <Copyright>Copyright (c) 2026 StruXllence</Copyright>
    <PackageReleaseNotes>Ported RotateDown, RotateLeft, RotateRight, SpinLeft and SpinRight from the main source with complete matching XML IntelliSense. Preserved double angle inputs in degrees, finite validation, caller-thread captured View dispatch and unacknowledged void completion. View now covers 13 of 70 source overloads and 13 of 67 reviewed native names. Full release notes: https://github.com/StruXllence/StaadPro.Interop/blob/main/docs/Release-Notes.md</PackageReleaseNotes>
    <Description>A strongly-typed .NET Framework wrapper for Bentley STAAD.Pro OpenSTAAD</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>staad;staad-pro;openstaad;structural-engineering;structural-analysis;engineering-automation;csharp;dotnet-framework;com-interop;geometry;loads;bentley;struxllence</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/StruXllence/StaadPro.Interop</RepositoryUrl>
    <PackageProjectUrl>https://github.com/StruXllence/StaadPro.Interop</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>images/symbol-only-logo.png</PackageIcon>
  </PropertyGroup>


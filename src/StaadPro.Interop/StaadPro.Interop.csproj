  <Target Name="PreparePackageDocumentation" BeforeTargets="_GetPackageFiles">
    <Error Condition="'$(Authors)' != 'Srinivasa Rao Masanam'" Text="The package Authors metadata must be exactly Srinivasa Rao Masanam." />
    <Error Condition="'$(PackageLicenseExpression)' != 'Apache-2.0'" Text="The package license expression must be exactly Apache-2.0." />
    <Error Condition="'$(Company)' != 'StruXllence'" Text="The package Company metadata must be exactly StruXllence." />
    <Error Condition="'$(Copyright)' != 'Copyright (c) 2026 StruXllence'" Text="The package Copyright metadata must be exactly Copyright (c) 2026 StruXllence." />
    <Error Condition="'$(Description)' != 'A strongly-typed .NET Framework wrapper for Bentley STAAD.Pro OpenSTAAD'" Text="The package Description metadata must be exactly A strongly-typed .NET Framework wrapper for Bentley STAAD.Pro OpenSTAAD." />
    <Error Condition="'$(RepositoryUrl)' != 'https://github.com/StruXllence/StaadPro.Interop'" Text="The package RepositoryUrl metadata must be exactly https://github.com/StruXllence/StaadPro.Interop." />
    <Error Condition="'$(PackageProjectUrl)' != 'https://github.com/StruXllence/StaadPro.Interop'" Text="The package PackageProjectUrl metadata must be exactly https://github.com/StruXllence/StaadPro.Interop." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(PackageVersion)', '^[0-9A-Za-z][0-9A-Za-z.+-]*$'))" Text="The package version contains unsupported characters." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ReleaseDocumentationVersion)', '^[0-9A-Za-z][0-9A-Za-z.+-]*$'))" Text="The release documentation version contains unsupported characters." />
    <Exec Command="powershell -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\..\eng\Prepare-PackageDocumentation.ps1&quot; -PackageVersion &quot;$(PackageVersion)&quot; -DocumentedVersion &quot;$(ReleaseDocumentationVersion)&quot; -ReadmeSource &quot;$(MSBuildProjectDirectory)\..\..\docs\NuGet-README.md&quot; -ReleaseNotesSource &quot;$(MSBuildProjectDirectory)\..\..\docs\Release-Notes.md&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)package-docs&quot;" />
  </Target>

